# DecisionOS Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local dev example: mongodb://localhost:27017
# Atlas example:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=decisionos

# ─── FastAPI ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production-min-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
