# DecisionOS Frontend Environment Configuration
# Person A (Frontend) / Person B (Backend) Bridge

# API Base URL for FastAPI Backend (Default: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Toggle between Mock Repositories (true) and Live API Repositories (false)
NEXT_PUBLIC_USE_MOCK_DATA=false

# API Request Timeout (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Environment Mode
NODE_ENV=development
